# ==========================================
# LabTriage AI - Environment Configuration
# ==========================================

# Database Settings
POSTGRES_USER=labtriage
POSTGRES_PASSWORD=labtriage_dev_password
POSTGRES_DB=labtriage
DATABASE_URL=postgresql://labtriage:labtriage_dev_password@postgres:5432/labtriage

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# AI Provider API Keys
# Paste your Gemini API key below when provided:
GEMINI_API_KEY=your_gemini_api_key_here
# Paste your OpenAI / Anthropic or other LLM API keys below if needed:
OPENAI_API_KEY=your_openai_api_key_here

# Local LLM / Ollama Settings
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Vector DB & RAG Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
EMBEDDING_MODEL=BAAI/bge-m3

# CORS & Application Settings
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
